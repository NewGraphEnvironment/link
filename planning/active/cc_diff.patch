+  # which reads it, is recomputed anyway, as the end-of-run pool always has.
+  rc_wsgs(w, rows(wsg = c("AAAA", "BBBB", "CCCC"), host = c("dispatcher", "dispatcher", "job1"),
+                  skip = "no"))
+  rc_deps(w, rows(wsg = "BBBB", dep = "CCCC"))
