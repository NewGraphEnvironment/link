+
+# --- the driver's wiring (structural) ---------------------------------------
+test_that("the driver prepares, starts, stops and finishes the early recompute in order", {
+  drv_path <- testthat::test_path("..", "..", "data-raw", "study_area_run.sh")
+  fin_path <- testthat::test_path("..", "..", "data-raw", "study_area_finish.sh")
+  testthat::skip_if_not(file.exists(drv_path) && file.exists(fin_path),
+                        "data-raw/study_area_*.sh absent")
+  drv <- readLines(drv_path)
+  fin <- readLines(fin_path)
+  line <- function(x, pat) {
+    i <- grep(pat, x, fixed = TRUE)
+    expect_length(i, 1L)
+    i[1]
+  }
+  # The flag, and --recompute-only turning it off.
+  line(drv, "--recompute-at-end) RECOMPUTE_EARLY=0 ;;")
+  line(drv, "  RECOMPUTE_EARLY=0")
+  # Prep before the backup (a running pg_dump would make the view build wait),
+  # the dependency map waited on before dispatch, the scheduler started after
+  # CONS_STATE is set (it is a subshell) and before legs_wait.
+  prep <- line(drv, "  recompute_views_prep")
+  backup <- line(drv, '  echo "=== dispatcher persist ($SCHEMA): backup in the background ==="')
+  expect_lt(prep, backup)
+  deps_wait <- line(drv, '  drc=0; wait "$RC_DEPS_PID" || drc=$?')
+  dispatch <- line(drv, 'echo "=== run buckets (DS-first) ==="')
+  expect_lt(deps_wait, dispatch)
+  cons <- grep('^CONS_STATE="\\$LOG_DIR/\\$\\{TS\\}_consolidate_state.tsv"$', drv)
+  sched <- line(drv, '  recompute_scheduler > "$LOG_DIR/${TS}_recompute_scheduler.log" 2>&1 &')
+  wait_legs <- grep("^legs_wait$", drv)
+  expect_length(cons, 1L)
+  expect_lt(cons, sched)
+  expect_lt(sched, wait_legs)
+  # The trap stops it starting anything new, before the burn.
+  t <- grep("^on_exit\\(\\) \\{", drv)
+  body <- drv[t:(t + which(drv[-seq_len(t)] == "}")[1])]
+  expect_lt(grep('[ -z "${RC_SCHED_PID:-}" ] || touch "$RC_STOP"', body, fixed = TRUE),
+            grep("burn_cyphers || rc=$?", body, fixed = TRUE))
+  # run_finish hands over the final set, never rebuilds the views or clears
+  # the per-job directory when the scheduler ran, and audits the early starts.
+  r <- grep("^run_finish_recompute\\(\\) \\{", fin)
+  rb <- fin[r:(r + which(fin[-seq_len(r)] == "}")[1])]
+  early <- grep("run_finish_recompute_early", rb, fixed = TRUE)
+  views <- grep("recompute_views_prep", rb, fixed = TRUE)
+  wipe <- grep('rm -rf "$RC_DIR"; mkdir -p "$RC_DIR"', rb, fixed = TRUE)
+  els <- grep("^  else$", rb)
+  expect_length(early, 1L)
+  expect_true(all(c(views, wipe) > els[1]))
+  expect_length(grep('Rscript data-raw/recompute_audit.R "$SCHEMA" "$RUN_UID"', rb, fixed = TRUE), 1L)
+  e <- grep("^run_finish_recompute_early\\(\\) \\{", fin)
+  eb <- fin[e:(e + which(fin[-seq_len(e)] == "}")[1])]
+  expect_lt(grep('recompute_final_write "$ALL_WSGS"', eb, fixed = TRUE),
+            grep('wait "$RC_SCHED_PID" || src=$?', eb, fixed = TRUE))
+  # The empty-coverage branch releases the scheduler too.
+  rf <- grep("^run_finish\\(\\) \\{", fin)
+  fb <- fin[rf:(rf + which(fin[-seq_len(rf)] == "}")[1])]
+  expect_length(grep('recompute_final_write "" || touch "$RC_STOP"', fb, fixed = TRUE), 1L)
+})
+
+test_that("the final set is acted on at once, not at the next poll", {
+  skip_if_no_rc_lib()
+  w <- hosts_world()
+  rc_wsgs(w, rows(wsg = "AAAA", host = "dispatcher", skip = "no"))
+  rc_deps(w, rows(wsg = character(), dep = character()))
+  put(w, "psql_local.out", db_answer(character(0)))
+  r <- rc_sched(w, c(
+    "RC_POLL=30",
+    "recompute_scheduler & sp=$!",
+    "sleep 2",
+    't0=$(date +%s); recompute_final_write "AAAA"',
+    'rc_wait "$sp"',
+    'echo "took=$(( $(date +%s) - t0 ))"'), job_sleep = 0)
+  took <- as.integer(sub("took=", "", regmatches(r$out, regexpr("took=[0-9]+", r$out))))
+  expect_lte(took, 5L)
+  expect_identical(rc_launched(w)$wsg, "AAAA")
+})
diff --git a/data-raw/logs/recompute_early_374/ab_compare.R b/data-raw/logs/recompute_early_374/ab_compare.R
new file mode 100644
index 00000000..62b2d25b
--- /dev/null
+++ b/data-raw/logs/recompute_early_374/ab_compare.R
@@ -0,0 +1,51 @@
+#!/usr/bin/env Rscript
+# ab_compare.R — link#374: the same groups built twice, once with the early
+# recompute (schema a) and once with --recompute-at-end (schema b). Every
+# group's streams_access, streams_mapping_code and gated habitat flags must
+# match row for row. Floating columns are compared after rounding to 6
+# decimals; geometry is left out.
+#
+# Usage: Rscript ab_compare.R <schema a> <schema b> <groups csv> [out.tsv]
+args <- commandArgs(trailingOnly = TRUE)
+a <- args[1]; b <- args[2]
+groups <- toupper(strsplit(args[3], ",", fixed = TRUE)[[1]])
+out <- if (length(args) >= 4L) args[4] else ""
+conn <- DBI::dbConnect(RPostgres::Postgres(), dbname = "fwapg", host = "localhost",
+                       port = 5432L, user = "postgres", password = "postgres")
+q <- function(sql) DBI::dbGetQuery(conn, sql)
+lit <- function(v) paste(DBI::dbQuoteString(conn, v), collapse = ",")
+tabs <- q(sprintf("SELECT table_name FROM information_schema.tables
+  WHERE table_schema = %s AND table_type = 'BASE TABLE'
+    AND (table_name IN ('streams_access', 'streams_mapping_code')
+         OR table_name LIKE 'streams_habitat\\_%%')
+  ORDER BY 1", DBI::dbQuoteString(conn, a)))$table_name
+flags <- c("accessible", "spawning", "rearing", "lake_rearing", "wetland_rearing")
+res <- do.call(rbind, lapply(tabs, function(t) {
+  cols <- q(sprintf("SELECT column_name, data_type FROM information_schema.columns
+    WHERE table_schema = %s AND table_name = %s ORDER BY ordinal_position",
+    DBI::dbQuoteString(conn, a), DBI::dbQuoteString(conn, t)))
+  cols <- cols[cols$data_type != "USER-DEFINED", ]
+  if (grepl("^streams_habitat_", t)) {
+    cols <- cols[cols$column_name %in% c("id_segment", "watershed_group_code", flags), ]
+  }
+  sel <- ifelse(cols$data_type %in% c("double precision", "real", "numeric"),
+                sprintf("round(%s::numeric, 6) AS %s", cols$column_name, cols$column_name),
+                cols$column_name)
+  sel <- paste(sel, collapse = ", ")
+  w <- sprintf("watershed_group_code IN (%s)", lit(groups))
+  r <- q(sprintf(
+    "WITH x AS (SELECT %1$s FROM %2$s.%4$s WHERE %5$s),
+          y AS (SELECT %1$s FROM %3$s.%4$s WHERE %5$s)
+     SELECT (SELECT count(*) FROM x) n_a, (SELECT count(*) FROM y) n_b,
+            (SELECT count(*) FROM (SELECT * FROM x EXCEPT ALL SELECT * FROM y) d) only_a,
+            (SELECT count(*) FROM (SELECT * FROM y EXCEPT ALL SELECT * FROM x) d) only_b",
+    sel, a, b, t, w))
+  data.frame(table = t, r)
+}))
+DBI::dbDisconnect(conn)
+print(res, row.names = FALSE)
+if (nzchar(out)) utils::write.table(res, out, sep = "\t", quote = FALSE, row.names = FALSE)
+same <- all(res$n_a == res$n_b & res$only_a == 0 & res$only_b == 0)
+cat(sprintf("%s vs %s over %d groups: %s\n", a, b, length(groups),
+            if (same) "identical" else "DIFFERENT"))
+quit(status = if (same) 0 else 1)
diff --git a/data-raw/logs/recompute_early_374/digest_test.R b/data-raw/logs/recompute_early_374/digest_test.R
new file mode 100644
index 00000000..58cb11d1
--- /dev/null
+++ b/data-raw/logs/recompute_early_374/digest_test.R
@@ -0,0 +1,116 @@
+#!/usr/bin/env Rscript
+# digest_test.R — link#374: is a group's recompute right when only its
+# dependency rule's groups are present? For one group G and each variant, a
+# scratch schema gets the `barriers` and `barrier_overrides` rows of:
+#
+#   all      every other group in the source schema (the full-run state)
+#   line     G's line-rule dependencies (recompute_deps.R; what the
+#            scheduler waits for)
+#   closure  G's outlet closure (#374's proposal; the negative control)
+#
+# then G is modelled into it as a run models it (LNK_HABITAT_GATE=0), and
+# recomputed as the driver recomputes it (wsg_recompute_one.R, LNK_LOG=0).
+# G's streams_access, streams_mapping_code and gated habitat flags are then
+# compared row by row with the `all` variant. `line` must match; `closure`
+# must not, for a group whose line dependencies reach outside its closure
+# (otherwise the test cannot tell the rules apart).
+#
+# Usage (repo root): Rscript data-raw/logs/recompute_early_374/digest_test.R \
+#   <WSG> <deps.tsv> <out dir> [source schema] [config]
+args   <- commandArgs(trailingOnly = TRUE)
+g      <- toupper(args[1]); deps_path <- args[2]; out <- args[3]
+src    <- if (length(args) >= 4L) args[4] else "fresh_default"
+config <- if (length(args) >= 5L) args[5] else "default"
+dir.create(out, showWarnings = FALSE, recursive = TRUE)
+
+suppressPackageStartupMessages(pkgload::load_all(quiet = TRUE))
+conn <- DBI::dbConnect(RPostgres::Postgres(), dbname = "fwapg", host = "localhost",
+                       port = 5432L, user = "postgres", password = "postgres")
+q <- function(sql) DBI::dbGetQuery(conn, sql)
+x <- function(sql) DBI::dbExecute(conn, sql)
+lit <- function(v) paste(DBI::dbQuoteString(conn, v), collapse = ",")
+
+deps <- utils::read.delim(deps_path, stringsAsFactors = FALSE)
+sets <- list(
+  all     = setdiff(q(sprintf("SELECT DISTINCT watershed_group_code w FROM %s.barriers", src))$w, g),
+  line    = deps$dep[deps$rule == "line" & deps$wsg == g],
+  closure = deps$dep[deps$rule == "closure" & deps$wsg == g])
+cat(sprintf("%s: line %d groups, closure %d; line outside closure: %s\n", g,
+            length(sets$line), length(sets$closure),
+            paste(setdiff(sets$line, sets$closure), collapse = ",")))
+
+run <- function(env, script, log) {
+  rc <- system2("env", c(env, "Rscript", script, g, config), stdout = log, stderr = log)
+  if (!identical(as.integer(rc), 0L)) stop(script, " failed for ", g, "; see ", log, call. = FALSE)
+}
+
+cfg <- lnk_config(config)
+sp <- tolower(cfg$species)
+res <- list()
+for (v in names(sets)) {
+  s <- paste0("fresh_374d_", tolower(v))
+  t0 <- Sys.time()
+  x(sprintf("DROP SCHEMA IF EXISTS %s CASCADE", s))
+  cfg$pipeline$schema <- s
+  lnk_persist_init(conn, cfg, species = cfg$species)
+  for (tb in c("barriers", "barrier_overrides")) {
+    cols <- q(sprintf("SELECT column_name FROM information_schema.columns
+      WHERE table_schema = '%s' AND table_name = '%s' ORDER BY ordinal_position", s, tb))$column_name
+    if (length(sets[[v]])) {
+      x(sprintf("INSERT INTO %s.%s (%s) SELECT %s FROM %s.%s WHERE watershed_group_code IN (%s)",
+                s, tb, paste(cols, collapse = ","), paste(cols, collapse = ","), src, tb,
+                lit(sets[[v]])))
+    }
+    x(sprintf("ANALYZE %s.%s", s, tb))
+  }
+  run(c(paste0("LNK_SCHEMA=", s), "LNK_LOAD=loadall", "LNK_GUARD_DOWNSTREAM=warn",
+        "LNK_HABITAT_GATE=0"), "data-raw/wsg_run_one.R", file.path(out, paste0(g, "_", v, "_model.log")))
+  run(c(paste0("LNK_SCHEMA=", s), "LNK_LOAD=loadall", "LNK_LOG=0"),
+      "data-raw/wsg_recompute_one.R", file.path(out, paste0(g, "_", v, "_recompute.log")))
+  cat(sprintf("  %-8s built in %.1f min\n", v, as.numeric(difftime(Sys.time(), t0, units = "mins"))))
+}
+
+# Row-by-row comparison with `all`, per table, on the full key.
+cmp <- function(tb, cols) {
+  a <- "fresh_374d_all"
+  do.call(rbind, lapply(c("line", "closure"), function(v) {
+    b <- paste0("fresh_374d_", v)
+    have <- q(sprintf("SELECT 1 FROM information_schema.tables WHERE table_schema = '%s' AND table_name = '%s'", a, tb))
+    if (!nrow(have)) return(NULL)
+    if (is.null(cols)) {
+      cols <- setdiff(q(sprintf("SELECT column_name FROM information_schema.columns
+        WHERE table_schema = '%s' AND table_name = '%s'", a, tb))$column_name, "geom")
+    }
+    r <- q(sprintf(
+      "WITH x AS (SELECT %1$s FROM %2$s.%4$s WHERE watershed_group_code = '%5$s'),
+            y AS (SELECT %1$s FROM %3$s.%4$s WHERE watershed_group_code = '%5$s')
+       SELECT (SELECT count(*) FROM x) n_all, (SELECT count(*) FROM y) n_variant,
+              (SELECT count(*) FROM (SELECT * FROM x EXCEPT SELECT * FROM y) d) only_all,
+              (SELECT count(*) FROM (SELECT * FROM y EXCEPT SELECT * FROM x) d) only_variant",
+      paste(cols, collapse = ","), a, b, tb, g))
+    data.frame(wsg = g, table = tb, variant = v, r)
+  }))
+}
+flags <- c("id_segment", "watershed_group_code", "accessible", "spawning", "rearing",
+           "lake_rearing", "wetland_rearing")
+out_tab <- rbind(
+  cmp("streams_access", NULL),
+  cmp("streams_mapping_code", NULL),
+  do.call(rbind, lapply(sp, function(s) {
+    tb <- paste0("streams_habitat_", s)
+    have <- q(sprintf("SELECT column_name FROM information_schema.columns
+      WHERE table_schema = 'fresh_374d_all' AND table_name = '%s'", tb))$column_name
+    if (!length(have)) return(NULL)
+    cmp(tb, intersect(flags, have))
+  })))
+print(out_tab, row.names = FALSE)
+utils::write.table(out_tab, file.path(out, paste0(g, "_digest.tsv")), sep = "\t",
+                   quote = FALSE, row.names = FALSE)
+line_ok <- all(out_tab$only_all[out_tab$variant == "line"] == 0 &
+               out_tab$only_variant[out_tab$variant == "line"] == 0)
+closure_differs <- any(out_tab$only_all[out_tab$variant == "closure"] > 0 |
+                       out_tab$only_variant[out_tab$variant == "closure"] > 0)
+cat(sprintf("%s: line matches all: %s; closure differs: %s\n", g, line_ok, closure_differs))
+for (v in names(sets)) x(sprintf("DROP SCHEMA IF EXISTS fresh_374d_%s CASCADE", tolower(v)))
+DBI::dbDisconnect(conn)
+quit(status = if (line_ok) 0 else 1)
diff --git a/data-raw/logs/recompute_early_374/headroom.sh b/data-raw/logs/recompute_early_374/headroom.sh
new file mode 100644
index 00000000..2ddbecc0
--- /dev/null
+++ b/data-raw/logs/recompute_early_374/headroom.sh
@@ -0,0 +1,54 @@
+#!/usr/bin/env bash
+# headroom.sh — link#374: does a -j8 recompute running beside the dispatcher's
+# modelling slow the modelling? A-B-A on one database: model the same groups
+# alone, then while a recompute pool runs, then alone again (so a cache that
+# warms between passes cannot read as contention).
+#
+# Model groups go to scratch <model schema>, recompute jobs to scratch
+# <recompute schema> (built by headroom_setup.R, views by
+# barriers_views_build.R) with LNK_LOG=0. Neither touches fresh_default.
+#
+# Usage (repo root): bash data-raw/logs/recompute_early_374/headroom.sh \
+#   <model schema> <model groups csv> <recompute schema> <recompute groups csv> <out dir> [width]
+set -euo pipefail
+MS="$1"; MG="$2"; RS="$3"; RG="$4"; OUT="$5"; W="${6:-8}"
+case "$MS$RS" in *fresh_default*) echo "refusing fresh_default" >&2; exit 1 ;; esac
+mkdir -p "$OUT/jobs"
+STOP="$OUT/STOP"; rm -f "$STOP"
+TSV="$OUT/headroom.tsv"
+printf 'pass\twsg\tstart_utc\tend_utc\tminutes\trc\n' > "$TSV"
+
+model_pass() {   # $1 = pass label
+  local w s e si ei rc
+  for w in $(printf '%s' "$MG" | tr ',' ' '); do
+    s=$(date -u +%s); si=$(date -u +%FT%TZ); rc=0
+    LNK_SCHEMA="$MS" LNK_LOAD=loadall LNK_GUARD_DOWNSTREAM=warn LNK_HABITAT_GATE=0 \
+      Rscript data-raw/wsg_run_one.R "$w" default > "$OUT/model_$1_$w.log" 2>&1 || rc=$?
+    e=$(date -u +%s); ei=$(date -u +%FT%TZ)
+    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$w" "$si" "$ei" \
+      "$(awk -v a="$s" -v b="$e" 'BEGIN { printf "%.2f", (b - a) / 60 }')" "$rc" >> "$TSV"
+  done
+}
+
+echo "=== A1 alone $(date -u +%FT%TZ)"
+model_pass A1
+
+echo "=== B with a -j$W recompute $(date -u +%FT%TZ)"
+# Twenty passes over the recompute groups, more than B needs; each job checks
+# STOP before it starts, so the pool drains once B's modelling is done.
+for i in $(seq 1 20); do printf '%s\n' "$RG" | tr ',' '\n' | sed "s/\$/ $i/"; done \
+  | xargs -P "$W" -L 1 sh -c '
+      [ -f "$0" ] && exit 0
+      LNK_LOG=0 LNK_VIEWS_PREBUILT=1 LNK_LOAD=loadall LNK_SCHEMA="$1" \
+        Rscript data-raw/wsg_recompute_one.R "$3" default > "$2/jobs/$3_$4.log" 2>&1 || true
+    ' "$STOP" "$RS" "$OUT" &
+POOL=$!
+sleep 90
+model_pass B
+touch "$STOP"
+echo "  draining the pool $(date -u +%FT%TZ)"
+wait "$POOL" || true
+
+echo "=== A2 alone $(date -u +%FT%TZ)"
+model_pass A2
+echo "=== done $(date -u +%FT%TZ)"
diff --git a/data-raw/logs/recompute_early_374/headroom_setup.R b/data-raw/logs/recompute_early_374/headroom_setup.R
new file mode 100644
index 00000000..8b141386
--- /dev/null
+++ b/data-raw/logs/recompute_early_374/headroom_setup.R
@@ -0,0 +1,52 @@
+#!/usr/bin/env Rscript
+# headroom_setup.R — link#374: a scratch schema the headroom benchmark can
+# recompute in without touching fresh_default. Holds the recompute groups'
+# persisted rows and EVERY group's barriers and barrier_overrides, so their
+# downstream walks see the whole province, as on a real run.
+#
+# Usage (repo root): Rscript data-raw/logs/recompute_early_374/headroom_setup.R \
+#                      <scratch schema> <groups csv> [source schema] [config]
+args <- commandArgs(trailingOnly = TRUE)
+dest   <- args[1]
+groups <- toupper(strsplit(args[2], ",", fixed = TRUE)[[1]])
+src    <- if (length(args) >= 3L) args[3] else "fresh_default"
+config <- if (length(args) >= 4L) args[4] else "default"
+stopifnot(grepl("^fresh_374", dest), dest != src)
+
+suppressPackageStartupMessages(pkgload::load_all(quiet = TRUE))
+conn <- DBI::dbConnect(RPostgres::Postgres(), dbname = "fwapg", host = "localhost",
+                       port = 5432L, user = "postgres", password = "postgres")
+cfg <- lnk_config(config)
+cfg$pipeline$schema <- dest
+DBI::dbExecute(conn, sprintf("DROP SCHEMA IF EXISTS %s CASCADE", dest))
+lnk_persist_init(conn, cfg, species = cfg$species)
+
+tabs <- DBI::dbGetQuery(conn, sprintf(
+  "SELECT c.table_name FROM information_schema.columns c
+   JOIN information_schema.tables t USING (table_schema, table_name)
+   WHERE c.table_schema = %s AND c.column_name = 'watershed_group_code'
+     AND t.table_type = 'BASE TABLE' AND c.table_name NOT LIKE 'log%%'
+   ORDER BY 1", DBI::dbQuoteString(conn, dest)))$table_name
+in_list <- paste(DBI::dbQuoteString(conn, groups), collapse = ",")
+for (t in tabs) {
+  have <- DBI::dbGetQuery(conn, sprintf(
+    "SELECT 1 FROM information_schema.tables WHERE table_schema = %s AND table_name = %s",
+    DBI::dbQuoteString(conn, src), DBI::dbQuoteString(conn, t)))
+  if (nrow(have) == 0L) next
+  cols <- intersect(
+    DBI::dbGetQuery(conn, sprintf("SELECT column_name FROM information_schema.columns
+      WHERE table_schema = %s AND table_name = %s ORDER BY ordinal_position",
+      DBI::dbQuoteString(conn, dest), DBI::dbQuoteString(conn, t)))$column_name,
+    DBI::dbGetQuery(conn, sprintf("SELECT column_name FROM information_schema.columns
+      WHERE table_schema = %s AND table_name = %s",
+      DBI::dbQuoteString(conn, src), DBI::dbQuoteString(conn, t)))$column_name)
+  where <- if (t %in% c("barriers", "barrier_overrides")) "" else
+    sprintf(" WHERE watershed_group_code IN (%s)", in_list)
+  n <- DBI::dbExecute(conn, sprintf("INSERT INTO %s.%s (%s) SELECT %s FROM %s.%s%s",
+    dest, t, paste(cols, collapse = ", "), paste(cols, collapse = ", "), src, t, where))
+  cat(sprintf("%-32s %9d rows\n", t, n))
+}
+DBI::dbExecute(conn, sprintf("ANALYZE %s.barriers", dest))
+DBI::dbExecute(conn, sprintf("ANALYZE %s.barrier_overrides", dest))
+DBI::dbDisconnect(conn)
+cat("=== headroom setup done\n")
