Package: link
Title: Develop, Test and Communicate Intrinsic Habitat and Connectivity
    Models for the BC Freshwater Atlas Stream Network
Version: 0.65.1
Date: 2026-10-15
Authors@R: c(
    person("Allan", "Irvine", , "al@newgraphenvironment.com", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-3495-2128",
                       affiliation = "New Graph Environment Ltd.")),
    person("Simon", "Norris", role = "ctb"),
